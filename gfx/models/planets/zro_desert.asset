
entity = {
    name = "zro_desert_planet_01_entity"
 
    locator = { name = "tiltLoc" position = { 0 0 0 } rotation = { 0 1 0 } }
 
    default_state = "idle"
	playback_rate = 1.0 # Animation speed 0
    state = { name = "idle" time_offset = { 15 0 } animation_speed = 0 }

    attach = { "tiltLoc" = "zro_desert_planet_01_mesh"}
	
	scale = 1.0

}
entity = {
	name = "zro_desert_planet_01_mesh"

	pdxmesh = "planet_clouded_mesh"
	default_state = "idle"

	meshsettings = {
	name = "planet_geosphereShape"
	texture_diffuse = "sandsea_01_diffuse.dds"
	texture_normal = "sandsea_01_normal.dds"
	texture_specular = "sandsea_01_spec.dds"
	}

	##cloud texture override
	meshsettings = {
	name = "clouds_geosphereShape"
	texture_diffuse = "clouds_zro_medium_diffuse.dds"
	texture_normal = "clouds_zro_medium_normal.dds"
	texture_specular = "clouds_zro_medium_specular.dds"
	}

	##cloud shadow texture override
	meshsettings = {
	name = "clouds_shadow_geosphereShape"
	texture_diffuse = "clouds_zro_shadow_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}

	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
}
